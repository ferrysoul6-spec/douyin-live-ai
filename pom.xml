<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>douyin-live-ai</artifactId>
  <version>0.1.0</version>
  <name>douyin-live-ai</name>
  <description>抖音直播间 AI 助播后端：进场欢迎 + AI 评论回复 + 语音播报</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 弹幕采集 SDK：连接抖音直播间 WebSocket、解析 protobuf、分发弹幕/礼物/进房/点赞事件（MIT）
         jitpack 构建失败，故本地克隆源码 mvn install 后按此坐标引用：
         git clone https://github.com/lulajax/DouyinLiveJava.git && cd DouyinLiveJava && mvn install -DskipTests -->
    <dependency>
      <groupId>com.douyinlive</groupId>
      <artifactId>douyin-live-client</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>douyin-live-ai</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
