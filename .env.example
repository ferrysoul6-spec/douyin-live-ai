# 只放密钥；业务配置全部在 src/main/resources/application.yml
# 复制为 .env 后填值（.env 已在 .gitignore 中，不会入库）

# 抖音签名服务：RapidAPI 订阅后复制的 X-RapidAPI-Key（连直播间必需）
RAPIDAPI_KEY=

# 火山方舟 API Key（LLM）。旧键名 DEEPSEEK_API_KEY 仍兼容
ARK_API_KEY=

# 火山 SeedTTS 语音专属 Key（UUID 形态，不是 ark- 开头的方舟 Key）
SEEDTTS_API_KEY=

# 可选：覆盖 application.yml 的 live-ai.tts.provider（seedtts / edge）
# TTS_PROVIDER=
